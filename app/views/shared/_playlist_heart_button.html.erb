<% if followed %>
  <%= button_to playlist_favorites_path(playlist),
                method: :delete,
                params: { button_class: button_class, size: size },
                form: { class: "heart-form", data: { turbo_stream: true } },
                class: "#{button_class} heart-active",
                aria: { label: "Remove playlist from saved" } do %>
    <%= icon :heart, size: size %>
  <% end %>
<% else %>
  <%= button_to playlist_favorites_path(playlist),
                method: :post,
                params: { button_class: button_class, size: size },
                form: { class: "heart-form", data: { turbo_stream: true } },
                class: button_class,
                aria: { label: "Save playlist" } do %>
    <%= icon :heart, size: size %>
  <% end %>
<% end %>
