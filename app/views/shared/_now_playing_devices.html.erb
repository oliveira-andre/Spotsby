<%
  current_session = Current.session
  active_id = user.active_session_id
  current = sessions.find { |s| s.id == current_session&.id }
  others = sessions.reject { |s| s.id == current_session&.id }
%>

<div id="now-playing-devices"
     class="now-playing-devices"
     data-controller="now-playing-devices">
  <% if current %>
    <button type="button"
            class="now-playing-devices__toggle <%= 'is-active' if active_id == current.id %>"
            data-now-playing-devices-target="toggleBtn"
            data-action="click->now-playing-devices#toggle"
            aria-expanded="false"
            aria-controls="now-playing-devices-list">
      <span class="now-playing-devices__dot"></span>
      <span class="now-playing-devices__label"><%= current.device_label %></span>
    </button>

    <ul id="now-playing-devices-list"
        class="now-playing-devices__list"
        data-now-playing-devices-target="list"
        hidden>
      <% others.each do |session| %>
        <% is_active = active_id == session.id %>
        <li class="now-playing-devices__item <%= 'is-active' if is_active %>">
          <%= button_to active_device_now_playing_path,
                        method: :patch,
                        params: { session_id: session.id },
                        form: { class: "now-playing-devices__form",
                                data: { turbo: true } },
                        class: "now-playing-devices__button",
                        disabled: is_active,
                        aria: { label: "Switch playback to #{session.device_label}" } do %>
            <span class="now-playing-devices__dot"></span>
            <span class="now-playing-devices__label"><%= session.device_label %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
