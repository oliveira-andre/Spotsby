<% payload = song_payload(song) %>

<div data-controller="song-loader"
     data-song-loader-id-value="<%= payload[:id] %>"
     data-song-loader-slug-value="<%= payload[:slug] %>"
     data-song-loader-name-value="<%= payload[:name] %>"
     data-song-loader-authors-value="<%= payload[:authors] %>"
     data-song-loader-album-value="<%= payload[:album] %>"
     data-song-loader-image-url-value="<%= payload[:image_url] %>"
     data-song-loader-image-content-type-value="<%= payload[:image_content_type] %>"
     data-song-loader-audio-url-value="<%= payload[:audio_url] %>"
     data-song-loader-fragment-url-value="<%= payload[:fragment_url] %>"
     data-song-loader-duration-ms-value="<%= payload[:duration_ms] %>">
</div>
