<% content_for :title, "Albums" %>

<section class="admin-albums">
  <header class="admin-albums__header">
    <%= form_with url: admin_albums_path,
                  method: :get,
                  class: "admin-albums__search",
                  data: { turbo_frame: "albums-frame", controller: "auto-submit" } do |form| %>
      <%= icon :magnifying_glass, size: 18 %>
      <%= form.search_field :q,
            value: params[:q],
            placeholder: "Search albums",
            class: "admin-albums__search-input",
            data: { action: "input->auto-submit#submit" } %>
    <% end %>

    <%= link_to new_admin_album_path,
                class: "admin-albums__new",
                aria: { label: "New album" },
                data: { turbo_frame: "album-form-modal" } do %>
      <%= icon :plus, size: 18 %>
    <% end %>
  </header>

  <%= turbo_frame_tag "albums-frame" do %>
    <% if @authors.any? %>
      <%= turbo_frame_tag :page, @pagy.page, target: :_top do %>
        <div class="admin-albums__groups">
          <% @authors.each do |author| %>
            <% author_albums = @albums_by_author[author.id] || [] %>
            <% next if author_albums.empty? %>

            <section class="admin-albums__group" id="<%= dom_id(author, :albums) %>">
              <header class="admin-albums__group-header">
                <% if author.image.attached? %>
                  <%= image_tag author.image, class: "admin-albums__group-art", loading: "lazy", alt: "" %>
                <% else %>
                  <span class="admin-albums__group-art admin-albums__group-art--placeholder">
                    <%= icon :microphone, size: 16 %>
                  </span>
                <% end %>
                <span class="admin-albums__group-name"><%= author.name %></span>
                <span class="admin-pill"><%= pluralize(author_albums.size, "album") %></span>
              </header>

              <ul class="admin-albums__list"
                  data-controller="sortable"
                  data-sortable-url-template-value="<%= update_position_admin_album_path(":id") %>">
                <%= render partial: "admin/albums/album", collection: author_albums, as: :album, locals: { song_counts: @song_counts } %>
              </ul>
            </section>
          <% end %>
        </div>

        <% if @pagy.next %>
          <%= turbo_frame_tag :page, @pagy.next,
                              src: admin_albums_path(page: @pagy.next, q: params[:q]),
                              loading: :lazy,
                              target: :_top do %>
            <p class="admin-albums__loading">Loading...</p>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="admin-albums__empty">
        <%= params[:q].present? ? "No albums matched “#{params[:q]}”." : "No albums yet." %>
      </p>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "album-form-modal" %>
</section>
