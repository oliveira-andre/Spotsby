<%= turbo_frame_tag "author-form-modal" do %>
  <div class="admin-modal admin-modal--wizard" id="author-wizard" data-controller="admin-modal" data-admin-modal-auto-open-value="true">
    <div class="admin-modal__backdrop" data-action="click->admin-modal#close"></div>

    <div class="admin-modal__panel admin-modal__panel--wizard" data-admin-modal-target="panel" role="dialog" aria-modal="true">
      <header class="admin-modal__header">
        <h2 class="admin-modal__title">New author</h2>
        <button type="button" class="admin-modal__close" aria-label="Close" data-action="click->admin-modal#close">
          <%= icon :close, size: 18 %>
        </button>
      </header>

      <%= turbo_frame_tag "author-wizard-summary" do %>
        <%= render "wizard_summary", author: @author, album: nil, songs: [], step: :author %>
      <% end %>

      <%= turbo_frame_tag "author-wizard-step" do %>
        <%= render "wizard_author", author: @author %>
      <% end %>
    </div>
  </div>
<% end %>
