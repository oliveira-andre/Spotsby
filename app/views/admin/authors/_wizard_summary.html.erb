<div class="wizard-progress">
  <ol class="wizard-steps">
    <li class="wizard-steps__item <%= 'is-current' if step == :author %> <%= 'is-done' if author&.persisted? && step != :author %>">
      <span class="wizard-steps__num">1</span>
      <span class="wizard-steps__name">Author</span>
    </li>
    <li class="wizard-steps__item <%= 'is-current' if step == :album %> <%= 'is-done' if album&.persisted? && step != :album %>">
      <span class="wizard-steps__num">2</span>
      <span class="wizard-steps__name">Album</span>
    </li>
    <li class="wizard-steps__item <%= 'is-current' if step == :song %>">
      <span class="wizard-steps__num">3</span>
      <span class="wizard-steps__name">Songs</span>
    </li>
  </ol>

  <% if author&.persisted? %>
    <div class="wizard-summary">
      <div class="wizard-summary__row">
        <% if author.image.attached? %>
          <%= image_tag author.image, class: "wizard-summary__art wizard-summary__art--round", alt: "" %>
        <% else %>
          <span class="wizard-summary__art wizard-summary__art--round wizard-summary__art--placeholder">
            <%= icon :microphone, size: 16 %>
          </span>
        <% end %>
        <div class="wizard-summary__info">
          <span class="wizard-summary__label">Author</span>
          <span class="wizard-summary__name"><%= author.name %></span>
        </div>
      </div>

      <% if album&.persisted? %>
        <div class="wizard-summary__row">
          <% if album.image.attached? %>
            <%= image_tag album.image, class: "wizard-summary__art", alt: "" %>
          <% else %>
            <span class="wizard-summary__art wizard-summary__art--placeholder">
              <%= icon :disc, size: 16 %>
            </span>
          <% end %>
          <div class="wizard-summary__info">
            <span class="wizard-summary__label">Album</span>
            <span class="wizard-summary__name"><%= album.name %></span>
          </div>
        </div>

        <% if songs.any? %>
          <div class="wizard-summary__songs">
            <span class="wizard-summary__label">Songs (<%= songs.size %>)</span>
            <ol class="wizard-summary__songs-list">
              <% songs.each do |s| %>
                <li class="wizard-summary__song">
                  <span class="wizard-summary__song-num"><%= s.position %></span>
                  <span class="wizard-summary__song-name"><%= s.name %></span>
                </li>
              <% end %>
            </ol>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
