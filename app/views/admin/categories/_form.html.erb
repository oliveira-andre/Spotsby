<% presets = Category::PRESET_COLORS %>

<div class="admin-modal" id="category-form" data-controller="admin-modal" data-admin-modal-auto-open-value="true">
  <div class="admin-modal__backdrop" data-action="click->admin-modal#close"></div>

  <div class="admin-modal__panel" data-admin-modal-target="panel" role="dialog" aria-modal="true">
    <header class="admin-modal__header">
      <h2 class="admin-modal__title"><%= category.persisted? ? "Edit category" : "New category" %></h2>
      <button type="button" class="admin-modal__close" aria-label="Close" data-action="click->admin-modal#close">
        <%= icon :close, size: 18 %>
      </button>
    </header>

    <% if category.errors.any? %>
      <div class="flash flash--alert" role="alert">
        <%= category.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with model: [:admin, category],
                  multipart: true,
                  class: "admin-modal__form",
                  data: { controller: "image-preview" } do |form| %>
      <div class="admin-modal__grid">
        <label class="admin-modal__cover" data-image-preview-target="dropzone">
          <%= form.file_field :image,
                              accept: "image/png,image/jpeg,image/webp",
                              class: "admin-modal__file",
                              data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
          <% if category.image.attached? %>
            <%= image_tag category.image, class: "admin-modal__preview", data: { image_preview_target: "preview" }, alt: "" %>
            <span class="admin-modal__placeholder" data-image-preview-target="placeholder" hidden>
              <%= icon :image, size: 36 %>
              <span>Choose photo</span>
            </span>
          <% else %>
            <img class="admin-modal__preview" data-image-preview-target="preview" alt="" hidden>
            <span class="admin-modal__placeholder" data-image-preview-target="placeholder">
              <%= icon :image, size: 36 %>
              <span>Choose photo</span>
            </span>
          <% end %>
        </label>

        <div class="admin-modal__fields">
          <div class="form-field">
            <%= form.label :name, "Name", class: "label" %>
            <%= form.text_field :name, class: "input", required: true, autofocus: true %>
          </div>

          <% if category.persisted? %>
            <div class="form-field">
              <%= form.label :position, "Position", class: "label" %>
              <%= form.number_field :position, class: "input", min: 1, value: category.position %>
            </div>
          <% end %>

          <div class="form-field" data-controller="color-picker" data-color-picker-theme-value="classic">
            <%= form.label :color, "Color", class: "label" %>

            <div class="color-picker">
              <button type="button"
                      class="color-picker__swatch"
                      data-color-picker-target="preview"
                      data-action="click->color-picker#openPicker"
                      style="background-color: <%= category.color || presets.first %>;"
                      aria-label="Pick color"></button>
              <span class="color-picker__hidden-trigger"
                    data-color-picker-target="button"
                    aria-hidden="true"></span>
              <%= form.hidden_field :color,
                                    value: category.color || presets.first,
                                    data: { color_picker_target: "input" } %>
            </div>

            <div class="color-presets">
              <% presets.each do |preset| %>
                <button type="button"
                        class="color-presets__chip"
                        data-color-picker-target="preset"
                        data-color="<%= preset %>"
                        data-action="click->color-picker#selectPreset"
                        style="background-color: <%= preset %>;"
                        aria-label="Use color <%= preset %>"></button>
              <% end %>
            </div>
          </div>
        </div>
      </div>

      <div class="admin-modal__actions">
        <%= form.submit "Save", class: "btn btn--primary btn--uppercase" %>
        <button type="button" class="btn btn--outlined btn--uppercase" data-action="click->admin-modal#close">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
