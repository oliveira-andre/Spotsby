<% categories = Rails.cache.fetch([ "admin/categories_for_select", Category.count, Category.maximum(:updated_at)&.to_i ]) do
     Category.ordered.pluck(:name, :id)
   end %>

<div class="admin-modal" id="song-form" data-controller="admin-modal" data-admin-modal-auto-open-value="true">
  <div class="admin-modal__backdrop" data-action="click->admin-modal#close"></div>

  <div class="admin-modal__panel" data-admin-modal-target="panel" role="dialog" aria-modal="true">
    <header class="admin-modal__header">
      <h2 class="admin-modal__title">Edit song</h2>
      <button type="button" class="admin-modal__close" aria-label="Close" data-action="click->admin-modal#close">
        <%= icon :close, size: 18 %>
      </button>
    </header>

    <% if song.errors.any? %>
      <div class="flash flash--alert" role="alert">
        <%= song.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <%= form_with model: [:admin, song],
                  multipart: true,
                  class: "admin-modal__form",
                  data: {
                    controller: "image-preview audio-duration gemini-ai-autocomplete",
                    gemini_ai_autocomplete_author_name_value: song.album&.author&.name.to_s,
                    gemini_ai_autocomplete_album_name_value: song.album&.name.to_s,
                    gemini_ai_autocomplete_categories_value: categories.to_json
                  } do |form| %>
      <div class="admin-modal__grid">
        <% cover = song.image.attached? ? song.image : (song.new_record? ? song.album&.image : nil) %>
        <label class="admin-modal__cover" data-image-preview-target="dropzone">
          <%= form.file_field :image,
                              accept: "image/png,image/jpeg,image/webp",
                              class: "admin-modal__file",
                              data: { image_preview_target: "input", action: "change->image-preview#preview" } %>
          <% if cover&.attached? %>
            <%= image_tag cover, class: "admin-modal__preview", data: { image_preview_target: "preview" }, alt: "" %>
            <span class="admin-modal__placeholder" data-image-preview-target="placeholder" hidden>
              <%= icon :music, size: 36 %>
              <span>Choose cover</span>
            </span>
          <% else %>
            <img class="admin-modal__preview" data-image-preview-target="preview" alt="" hidden>
            <span class="admin-modal__placeholder" data-image-preview-target="placeholder">
              <%= icon :music, size: 36 %>
              <span>Choose cover</span>
            </span>
          <% end %>
        </label>

        <div class="admin-modal__fields">
          <div class="form-field">
            <%= form.label :name, "Title", class: "label" %>
            <%= form.text_field :name,
                                class: "input",
                                required: true,
                                autofocus: true,
                                data: { gemini_ai_autocomplete_target: "nameInput" } %>
          </div>

          <div class="form-field">
            <%= form.label :audio, "Audio file", class: "label" %>
            <%= form.file_field :audio,
                                accept: "audio/mpeg,audio/mp4,audio/ogg,audio/wav",
                                class: "input",
                                data: {
                                  audio_duration_target: "file",
                                  action: "change->audio-duration#read"
                                } %>
            <span class="form-field__hint">MP3, M4A, OGG, or WAV. Up to 100MB.</span>
          </div>

          <div class="admin-modal__row">
            <div class="form-field">
              <div class="label-row">
                <%= form.label :category_id, "Category", class: "label" %>
                <button type="button"
                        class="ai-button"
                        data-gemini-ai-autocomplete-target="categoryButton"
                        data-action="click->gemini-ai-autocomplete#fillCategory">AI</button>
              </div>
              <%= render "shared/select", placeholder: "Choose category", search_placeholder: "Search categories…" do %>
                <%= form.select :category_id,
                                categories,
                                {},
                                class: "select__native",
                                required: true,
                                data: {
                                  select_target: "select",
                                  gemini_ai_autocomplete_target: "categoryField"
                                } %>
              <% end %>
            </div>
            <div class="form-field">
              <%= form.label :duration_ms, "Duration (ms)", class: "label" %>
              <%= form.number_field :duration_ms,
                                    class: "input",
                                    min: 0,
                                    data: { audio_duration_target: "duration" } %>
            </div>
          </div>

          <div class="admin-modal__row">
            <div class="form-field">
              <div class="label-row">
                <%= form.label :age, "Age rating", class: "label" %>
                <button type="button"
                        class="ai-button"
                        data-gemini-ai-autocomplete-target="ageButton"
                        data-action="click->gemini-ai-autocomplete#fillAge">AI</button>
              </div>
              <%= form.number_field :age,
                                    class: "input",
                                    min: 0,
                                    data: { gemini_ai_autocomplete_target: "ageField" } %>
            </div>
            <div class="form-field">
              <div class="label-row">
                <%= form.label :monthly_listeners, "Monthly listeners", class: "label" %>
                <button type="button"
                        class="ai-button"
                        data-gemini-ai-autocomplete-target="listenersButton"
                        data-action="click->gemini-ai-autocomplete#fillListeners">AI</button>
              </div>
              <%= form.number_field :monthly_listeners,
                                    class: "input",
                                    min: 0,
                                    data: { gemini_ai_autocomplete_target: "listenersField" } %>
            </div>
          </div>

          <label class="form-field form-field--toggle">
            <span class="form-field__toggle-meta">
              <span class="label label--inline">Mark as popular</span>
              <span class="form-field__hint">Show this song in the artist's popular tracks.</span>
            </span>
            <span class="toggle">
              <%= form.check_box :popular, class: "toggle__input" %>
              <span class="toggle__slider" aria-hidden="true"></span>
            </span>
          </label>

          <% album_author_id = song.album&.author_id %>
          <%= render "admin/shared/song_authors_picker",
                     exclude_author_id: album_author_id,
                     selected_ids: song.author_ids - [album_author_id].compact %>

          <% if song.persisted? %>
            <div class="form-field">
              <%= form.label :position, "Position", class: "label" %>
              <%= form.number_field :position, class: "input", min: 1, value: song.position %>
            </div>
          <% end %>

          <div class="form-field">
            <div class="label-row">
              <%= form.label :lyrics, "Lyrics", class: "label" %>
              <button type="button"
                      class="ai-button"
                      data-gemini-ai-autocomplete-target="lyricsButton"
                      data-action="click->gemini-ai-autocomplete#fillLyrics">AI</button>
            </div>
            <%= form.text_area :lyrics,
                               class: "input input--autogrow",
                               rows: 4,
                               data: {
                                 controller: "textarea-autogrow",
                                 gemini_ai_autocomplete_target: "lyricsField"
                               } %>
          </div>
        </div>
      </div>

      <div class="admin-modal__actions">
        <%= form.submit "Save", class: "btn btn--primary btn--uppercase" %>
        <button type="button" class="btn btn--outlined btn--uppercase" data-action="click->admin-modal#close">Cancel</button>
      </div>
    <% end %>
  </div>
</div>
