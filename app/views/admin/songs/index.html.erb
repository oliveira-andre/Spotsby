<% content_for :title, "Songs" %>

<% filter_params = params.permit(:q, :author_id, :album_id).to_h.compact_blank %>

<section class="admin-songs">
  <header class="admin-songs__header">
    <%= form_with url: admin_songs_path,
                  method: :get,
                  class: "admin-songs__filters",
                  data: {
                    controller: "auto-submit filters-form album-filter",
                    filters_form_frame_value: "songs-frame"
                  } do |form| %>
      <div class="admin-songs__search">
        <%= icon :magnifying_glass, size: 18 %>
        <%= form.search_field :q,
              value: params[:q],
              placeholder: "Search song, album, or author",
              class: "admin-songs__search-input",
              data: { action: "input->auto-submit#submit" } %>
      </div>

      <%= render "shared/select", placeholder: "All authors", variant: "pill", search_placeholder: "Search authors…" do %>
        <%= form.select :author_id,
                        @authors_for_filter,
                        { include_blank: "All authors", selected: params[:author_id] },
                        class: "select__native",
                        data: {
                          select_target: "select",
                          action: "change->album-filter#authorChanged change->auto-submit#submit",
                          album_filter_target: "author"
                        } %>
      <% end %>

      <%= render "shared/select", placeholder: "All albums", variant: "pill", search_placeholder: "Search albums…" do %>
        <%= form.select :album_id,
                        options_for_select(
                          @albums_for_filter.map { |a| ["#{a.name} — #{a.author.name}", a.id, { data: { author_id: a.author_id } }] },
                          params[:album_id]
                        ),
                        { include_blank: "All albums" },
                        class: "select__native",
                        data: {
                          select_target: "select",
                          action: "change->auto-submit#submit",
                          album_filter_target: "album"
                        } %>
      <% end %>

      <% if filter_params.any? %>
        <%= link_to "Clear", admin_songs_path, class: "admin-songs__filter-clear" %>
      <% end %>
    <% end %>

    <%= link_to new_admin_song_path,
                class: "admin-songs__new",
                aria: { label: "New song" },
                data: { turbo_frame: "song-form-modal" } do %>
      <%= icon :plus, size: 18 %>
    <% end %>
  </header>

  <%= turbo_frame_tag "songs-frame", data: { turbo_action: "advance" } do %>
    <% if @albums.any? %>
      <%= turbo_frame_tag :page, @pagy.page, target: :_top do %>
        <div class="admin-songs__groups">
          <% @albums.each do |album| %>
            <% album_songs = @songs_by_album[album.id] || [] %>
            <% next if album_songs.empty? %>

            <section class="admin-songs__group" id="<%= dom_id(album, :songs) %>">
              <header class="admin-songs__group-header">
                <% if album.image.attached? %>
                  <%= image_tag album.image, class: "admin-songs__group-art", loading: "lazy", alt: "" %>
                <% else %>
                  <span class="admin-songs__group-art admin-songs__group-art--placeholder">
                    <%= icon :disc, size: 18 %>
                  </span>
                <% end %>
                <div class="admin-songs__group-meta">
                  <span class="admin-songs__group-name"><%= album.name %></span>
                  <span class="admin-songs__group-sub"><%= album.author.name %></span>
                </div>
                <span class="admin-pill"><%= pluralize(album_songs.size, "song") %></span>
              </header>

              <ul class="admin-songs__list"
                  data-controller="sortable"
                  data-sortable-url-template-value="<%= update_position_admin_song_path(":id") %>">
                <%= render partial: "admin/songs/song", collection: album_songs, as: :song %>
              </ul>
            </section>
          <% end %>
        </div>

        <% if @pagy.next %>
          <%= turbo_frame_tag :page, @pagy.next,
                              src: admin_songs_path(filter_params.merge(page: @pagy.next).compact),
                              loading: :lazy,
                              target: :_top do %>
            <p class="admin-songs__loading">Loading...</p>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <p class="admin-songs__empty">
        <%= filter_params.any? ? "No songs match the current filters." : "No songs yet." %>
      </p>
    <% end %>
  <% end %>

  <%= turbo_frame_tag "song-form-modal" %>
</section>
