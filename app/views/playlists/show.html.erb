<%
  songs = @playlist_songs.map(&:song)
  song_ids = songs.map { |s| s.id.to_s }
  first_song = songs.first
  first_song_image_blob =
    if first_song&.image&.attached?
      first_song.image
    elsif @playlist.image.attached?
      @playlist.image
    end
  first_song_image_url = first_song_image_blob ? url_for(first_song_image_blob) : nil
  first_song_image_content_type = first_song_image_blob&.blob&.content_type
  first_song_audio_url = first_song&.audio&.attached? ? url_for(first_song.audio) : nil
  first_song_authors = first_song ? first_song.authors.map(&:name).join(", ") : nil
  owner = @playlist.user_id == current_user.id
%>

<div class="playlist-show"
     data-controller="album-show"
     data-album-show-now-playing-outlet="#minimal-player"
     data-album-show-song-ids-value="<%= song_ids.to_json %>"
     data-album-show-first-id-value="<%= first_song&.id %>"
     data-album-show-first-slug-value="<%= first_song&.slug %>"
     data-album-show-first-name-value="<%= first_song&.name %>"
     data-album-show-first-authors-value="<%= first_song_authors %>"
     data-album-show-first-image-url-value="<%= first_song_image_url %>"
     data-album-show-first-image-content-type-value="<%= first_song_image_content_type %>"
     data-album-show-first-audio-url-value="<%= first_song_audio_url %>">
  <header class="playlist-show__header">
    <%= link_to library_path,
                class: "playlist-show__back",
                data: { turbo_stream: true, controller: "back-link" },
                aria: { label: "Back" } do %>
      <%= icon :chevron_left, size: 24 %>
    <% end %>

    <% if @playlist.image.attached? %>
      <div class="playlist-show__hero playlist-show__hero--image"
           style="background-image: url('<%= url_for(@playlist.image) %>');">
        <%= render "name", playlist: @playlist %>
      </div>
    <% else %>
      <div class="playlist-show__hero">
        <%= render "name", playlist: @playlist %>
      </div>
    <% end %>
  </header>

  <div class="playlist-show__actions">
    <div class="playlist-show__actions-left">
      <% if owner && @playlist.position != 0 %>
        <%= button_to song_picker_playlist_path(@playlist),
                      method: :get,
                      form: { class: "playlist-show__icon-form", data: { turbo_stream: true } },
                      class: "playlist-show__icon-btn",
                      aria: { label: "Add songs" } do %>
          <%= icon :plus, size: 22 %>
        <% end %>
      <% end %>
      <% unless owner %>
        <%= render "shared/playlist_heart",
                   playlist: @playlist,
                   followed: current_user.followed_playlist?(@playlist),
                   size: 22,
                   button_class: "playlist-show__icon-btn" %>
        <%= button_to clone_playlist_path(@playlist),
                      method: :post,
                      form: { class: "playlist-show__icon-form" },
                      class: "playlist-show__icon-btn",
                      aria: { label: "Clone playlist" } do %>
          <%= icon :clone, size: 22 %>
        <% end %>
      <% end %>
      <%= button_to random_song_playlist_path(@playlist),
                    form: { class: "playlist-show__icon-form", data: { turbo_stream: true } },
                    class: "playlist-show__icon-btn",
                    aria: { label: "Play a random song" } do %>
        <%= icon :shuffle, size: 22 %>
      <% end %>
    </div>
    <button type="button"
            class="playlist-show__play"
            aria-label="Play"
            data-action="click->album-show#toggle"
            data-album-show-target="playButton">
      <span data-album-show-target="playIcon"><%= icon :play, size: 25 %></span>
      <span data-album-show-target="pauseIcon" hidden><%= icon :pause, size: 25 %></span>
    </button>
  </div>

  <ul class="playlist-show__songs"
      id="playlist_songs_<%= @playlist.id %>"
      data-controller="<%= "sortable " if owner %>song-actions-trigger"
      data-song-actions-trigger-modal-outlet="#song-actions-modal"
      <% if owner %>
        data-sortable-url-template-value="<%= update_position_playlist_song_path(@playlist, ":id") %>"
      <% end %>>
    <% songs.each do |song| %>
      <%= render "playlists/song_row", playlist: @playlist, song: song, owner: owner %>
    <% end %>
  </ul>
  <% if songs.empty? %>
    <p class="playlist-show__empty" id="playlist_empty_<%= @playlist.id %>">
      No songs in this playlist yet.
    </p>
  <% end %>

  <%= render "shared/song_actions_modal" %>
</div>

<% if owner && params[:picker].present? %>
  <% songs_to_pick = Song.joins(:playlist_songs)
                         .where(playlist_songs: { playlist_id: current_user.playlist_ids - [@playlist.id] })
                         .with_attached_image
                         .includes(:authors, :album)
                         .distinct
                         .limit(30) %>
  <%= render "playlists/song_picker_modal",
             playlist: @playlist,
             songs: songs_to_pick,
             query: "",
             auto_open: true %>
<% end %>
