<%= turbo_frame_tag "song_actions_body" do %>
  <div class="song-actions">
    <div class="song-actions__details">
      <% if @song.album&.image&.attached? %>
        <%= image_tag @song.album.image, class: "song-actions__thumb", alt: @song.album.name, loading: "lazy" %>
      <% elsif @song.image.attached? %>
        <%= image_tag @song.image, class: "song-actions__thumb", alt: @song.name, loading: "lazy" %>
      <% else %>
        <div class="song-actions__thumb song-actions__thumb--placeholder"></div>
      <% end %>
      <div class="song-actions__text">
        <p class="song-actions__name"><%= @song.name %></p>
        <p class="song-actions__artist"><%= @song.authors.map(&:name).join(", ") %></p>
        <% if @song.album %>
          <p class="song-actions__album"><%= @song.album.name %></p>
        <% end %>
      </div>
    </div>

    <% if @playlists.any? && (@saved_song_playlsit.song_ids.any?(@song.id) || @playlists.any? { |playlist| playlist.song_ids.include?(@song.id) }) %>
      <div class="song-actions__playlists">
        <ul class="playlists-modal__list">
          <% @playlists.each do |playlist| %>
            <li>
              <%= button_to add_song_to_playlist_favorites_path(@song, playlist_id: playlist.id),
                            method: :post,
                            form: { class: "playlists-modal__form", data: { turbo_stream: true } },
                            class: "playlists-modal__option" do %>
                <% if playlist.image.attached? %>
                  <%= image_tag playlist.image, class: "playlists-modal__art", loading: "lazy", alt: "" %>
                <% else %>
                  <div class="playlists-modal__art playlists-modal__art--initial">
                    <%= playlist.name.to_s.first&.upcase %>
                  </div>
                <% end %>
                <span class="playlists-modal__name"><%= playlist.name %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= button_to song_queues_path(song_id: @song.id),
                  method: :post,
                  class: "song-actions__option",
                  form: { class: "song-actions__form", data: { turbo_stream: true } } do %>
      <span class="song-actions__option-icon"><%= icon :plus, size: 18 %></span>
      <span class="song-actions__option-label">Add to queue</span>
    <% end %>
  </div>
<% end %>
