<div class="home" data-controller="sidebar filters">
  <header class="home__header">
    <button type="button"
            class="home__avatar-button"
            aria-label="Open menu"
            data-action="click->sidebar#open">
      <% if current_user.avatar.attached? %>
        <%= image_tag current_user.avatar, class: "avatar", loading: "lazy" %>
      <% else %>
        <div class="avatar avatar--initials">
          <%= user_initials(current_user) %>
        </div>
      <% end %>
    </button>

    <div class="filters" role="tablist" aria-label="Browse filter">
      <%= link_to "All", home_all_path,
                  class: "filters__chip is-active",
                  role: "tab",
                  aria: { selected: "true" },
                  data: { turbo_frame: "home_filtered", action: "click->filters#select", filter: "all" } %>
      <%= link_to "Albums", recent_albums_path,
                  class: "filters__chip",
                  role: "tab",
                  aria: { selected: "false" },
                  data: { turbo_frame: "home_filtered", action: "click->filters#select", filter: "albums" } %>
      <%= link_to "Artists", recent_artists_path,
                  class: "filters__chip",
                  role: "tab",
                  aria: { selected: "false" },
                  data: { turbo_frame: "home_filtered", action: "click->filters#select", filter: "artists" } %>
    </div>
  </header>

  <main class="home__body">
    <%= turbo_frame_tag :home_filtered do %>
      <%= render "home/index_body" %>
    <% end %>
  </main>

  <%= render "home/sidebar" %>
</div>
