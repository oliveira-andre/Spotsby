<% pinned_playlist, sortable_playlists = @playlists.partition { |p| p.position.to_i.zero? } %>

<div class="library">
  <header class="library__header">
    <h1 class="library__title">Your Library</h1>
  </header>

  <% if pinned_playlist.any? %>
    <ul class="library__list library__list--pinned">
      <% pinned_playlist.each do |playlist| %>
        <%= render "home/library_item", playlist: playlist %>
      <% end %>
    </ul>
  <% end %>

  <ul class="library__list"
      data-controller="sortable"
      data-sortable-url-template-value="<%= update_position_playlist_path(":id") %>">
    <% sortable_playlists.each do |playlist| %>
      <%= render "home/library_item", playlist: playlist %>
    <% end %>
  </ul>

  <% if @followed_playlist_follows.any? %>
    <h2 class="library__section-title">Followed playlists</h2>
    <ul class="library__list"
        data-controller="sortable"
        data-sortable-url-template-value="<%= update_position_playlist_follow_path(":id") %>">
      <% @followed_playlist_follows.each do |playlist_follow| %>
        <%= render "home/library_follow_item", playlist_follow: playlist_follow %>
      <% end %>
    </ul>
  <% end %>
</div>
